# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# prisma generated client
/src/generated

# local file-storage driver uploads
/.uploads

# misc
.DS_Store

# 金鑰檔。tvote-key-*.json 是 KeyGenPanel 下載的開票私鑰（一旦誤入 git 該場選舉即失去匿名性）。
*.pem
*.key
*.crt
*.p12
tvote-key-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktrees（本機工具狀態，不是專案內容）
.claude/worktrees/

# Next build symlink（worktree 測試用）
.next
