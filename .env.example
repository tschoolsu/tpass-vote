# 真值放 .env.local（不進 git）。本檔只列 key + 說明；本機預設值可直接照抄。

# ── SSO（契約 v2，見 tpass-auth/INTEGRATION.md）───────────────────────
TPASS_SERVICE_ID=vote
JWT_ISSUER=https://auth.lvh.me:3000
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout
VOTE_SELF_URL=https://vote.lvh.me:3006
PORTAL_URL=https://portal.lvh.me:3001

# ── 資料庫（本機慣例：postgresql://t_vote@localhost:5432/t_vote）──────
DATABASE_URL=postgresql://t_vote@localhost:5432/t_vote

# ── 管理員 ─────────────────────────────────────────────────────────
# 超級管理員種子（逗號分隔，恆為管理員 + 唯一能管 Admin 名單的人）。
SUPER_ADMIN_EMAILS=

# ── 檔案儲存（候選人登記附件；見 src/lib/storage.ts）───────────────────
# local（預設，寫本機 ./.uploads，僅本機 demo 用）｜ s3（上線接 S3/Supabase Storage，尚未實作 SDK）
STORAGE_DRIVER=local

# ── production smoke（pnpm start:https / server.mjs）用，本機開發跑 pnpm dev 不需要 ──
TLS_KEY_FILE=
TLS_CERT_FILE=

# 選填：ban 導去的頁面。未設就從 AUTH_AUTHORIZE_URL 的 origin 推 /denied（見 src/config/auth.ts deniedUrlFor）。
# AUTH_DENIED_URL=https://auth.lvh.me:3000/denied
