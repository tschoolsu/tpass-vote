// tpass-vote 資料模型。開票私鑰不落地：只存公鑰；sealedBox 為彌封後（去識別、洗牌）的密文快照。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 選舉主檔。開票私鑰不落地：只存公鑰；sealedBox 為彌封後（去識別、洗牌）的密文快照。
model Election {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  title                   String
  kind                    String // leader | grade_rep | other | recall
  parentId                String? // 重選場次指向原選舉；罷免場次指向原選舉
  lineage                 String? // runoff | by_election | redo（複製來源類型，供 UI 區分同票重選/罷免補選/重辦）
  seats                   Int       @default(1)
  maxChoices              Int       @default(1)
  status                  String    @default("draft") // draft | registration | campaigning | voting | closed | sealed | published | petition | established（後兩者為罷免專屬前置）
  ballotMode              String? // choose | approval（開放投票時依核准候選人數判定）
  registrationStartsAt    DateTime?
  registrationEndsAt      DateTime?
  votingStartsAt          DateTime?
  votingEndsAt            DateTime?
  tallyPublicKeyJwk       Json?
  keyShares               Int       @default(1) // 1 | 2（開票金鑰分持份數）
  sealedBox               Json? // string[] 密文陣列（無身分、順序已洗牌）
  sealedHash              String?
  sealedAt                DateTime?
  sealedBy                String?
  resultsJson             Json?
  // §26-1 Ⅳ/Ⅴ：記載可回溯代碼之去識別化選舉人個別意思（DisclosureEntry[]，見 src/lib/disclosure.ts）。
  // 開票時由選委瀏覽器產出、伺服器交叉驗證後落地，隨結果公告公開。
  disclosuresJson         Json?
  hiddenAt                DateTime? // null=正常；非 null=管理員軟刪除（隱藏）。資料完全保留，不做實體刪除。
  recallReason            String? // 罷免理由（kind=recall 專用）
  recallDefense           String? // 被罷免人答辯書，選填（kind=recall 專用）
  recallTargetCandidateId String? // 本罷免案自建的「罷免用候選人（組）」id＝計票對象（kind=recall 專用）
  recallTargetOfficeId    String? // 罷免案指向的職務（業務/門檻判準；kind=recall 專用）
  recallLeadEmail         String? // 領銜人 email（公開發起罷免留痕；kind=recall 專用）
  recallLeadName          String? // 領銜人姓名，取自 session.name（kind=recall 專用）
  officeId                String? // 這場選舉「填哪個既有職務」；null=genesis（公告時自動新建職務並回填）。單一職務選舉才設。
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  announcements    Announcement[]
  candidates       Candidate[]
  voters           Voter[]
  ballots          EncryptedBallot[]
  recallSignatures RecallSignature[]
  auditLogs        ElectionAuditLog[]
  office           Office?           @relation("ElectionFillsOffice", fields: [officeId], references: [id])
  targetOffice     Office?           @relation("RecallTargetOffice", fields: [recallTargetOfficeId], references: [id])

  @@index([status])
  @@index([recallTargetOfficeId])
}

// 自由公告流：一般公告可任意多則；legalTag 非 null 者為法定里程碑公告（每場至多一則，由
// action 層強制），null 為一般公告（不受此限）。
// 「每場至多一則 legalTag='result'」除了 action 層先查後寫，DB 端也有最後一道防線：
// migration 20260906181105_result_announcement_unique 手寫了一條 partial unique index
// （Prisma schema 語法不支援 partial index，改在 migration.sql 直接下 raw SQL）：
//   CREATE UNIQUE INDEX "Announcement_electionId_result_key"
//     ON "Announcement" ("electionId") WHERE "legalTag" = 'result';
// 撞到這條索引時 action 層要 catch P2002 回友善錯誤，不能讓例外裸奔成 500。
model Announcement {
  id          String    @id @default(cuid())
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  legalTag    String? // null=一般公告；first | second | result（法定里程碑，每場至多一則）
  title       String
  body        String // markdown
  publishedAt DateTime? // null = 草稿
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([electionId])
}

model Candidate {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  members     Json // [{name,email,grade}]；leader 聯名 2 人，其餘 1 人
  number      Int? // 號次，審核通過後編定
  platform    String // 政見
  attachments Json? // Upload id 清單（學生證影本等）
  status      String   @default("pending") // pending | needs_fix | approved | rejected | withdrawn
  reviewNote  String?
  createdBy   String // 登記者 email（伺服器端從 session 戳，不信 client）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([electionId, number])
  @@unique([electionId, createdBy])
  @@index([electionId, status])
}

// 選舉人名冊（選委會上傳）。
model Voter {
  id         String    @id @default(cuid())
  electionId String
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  // 只記「投過沒」，不記何時投的。精確時間戳可以跟票匭的實體列順序 rank-join，
  // 把匿名票匭一張一張對回人——那等於把剛拿掉的 voterId 用另一種形式寫回去。
  // 彌封後保留——§26-1 Ⅴ 的「投票暨未投票選舉人名冊」靠它產生，而那份名冊本來就只列有無。
  hasVoted   Boolean   @default(false)

  @@unique([electionId, email])
}

// 內信封：無開票私鑰不可解。**這張表任何時候都不得有指向 Voter 的欄位或 relation**，
// 投票期間也不行——一人一票改由 Voter.hasVoted 的鎖內判定達成（見 e/[slug]/vote/actions.ts）。
// 這張表只是「投票期間的暫存格」：彌封時整場刪除（見 admin/elections/[id]/tally/actions.ts），
// 密文改由 Election.sealedBox（已洗牌）保存。§26-1 Ⅳ 要求不得記錄代碼與個別選舉人之連結，
// 任何讓這個連結存活的改動都是違法，不是效能取捨。
model EncryptedBallot {
  // uuid(4) 而非 cuid()：cuid 前綴含時間、可排序，等於把投票順序寫進主鍵。
  // 絕不可改成 uuid(7)——v7 前綴就是毫秒時間戳，等於把 updatedAt 用另一個名字加回來。
  id         String   @id @default(uuid(4))
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  ciphertext String // base64(RSA-OAEP 包 AES 金鑰 + AES-GCM 密文)

  @@index([electionId])
}

// 罷免連署（具名、一人一署）。門檻與通過判定見 src/lib/recall.ts。
model RecallSignature {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  signerEmail String
  createdAt   DateTime @default(now())

  @@unique([electionId, signerEmail])
  @@index([electionId])
}

// 檔案上傳：候選人登記附件（學生證影本等）。與 tpass-form 的 Upload 模式一致——
// 只存 electionId 作範圍界線（配額、下載授權查詢），不用 FK 關聯（照抄 form 的作法）。
// kind 區分公開／私密：photo=候選人公開大頭照（走 /api/photos/[id]，免 admin，只吐 photo）；
// attachment=學生證影本等私密附件（走 /api/files/[id]，admin-only，行為不變）。
model Upload {
  id          String   @id @default(cuid())
  electionId  String
  storageKey  String // 物件儲存 key
  filename    String
  mime        String
  size        Int
  uploaderSub String
  kind        String   @default("attachment") // photo | attachment
  createdAt   DateTime @default(now())

  @@index([electionId])
}

// 職務任期紀錄：跨選舉週期持久存在（同一職務連任/補選是同一筆 row 被更新，不是新增）。
// 由選舉「公告結果」時自動 upsert（見 src/lib/office-upsert.ts），選委可事後手動編輯。
// 是罷免功能的「對象」單位；就職日（startedAt）供 §27 兩個月硬擋，termValidCount 供 §28 門檻。
model Office {
  id               String    @id @default(cuid())
  title            String // 職務名稱（顯示用，可改；識別靠 Election.officeId 明確關聯，不做 unique）
  currentMembers   Json // [{name,email,grade}]；聯名（會長副會長）存成一組，從缺時 []
  isVacant         Boolean   @default(false)
  startedAt        DateTime? // 入職日；從缺時 null
  sourceElectionId String? // 現任這一任由哪場選舉/補選產生（軟關聯，不設 FK，比照 Upload.electionId）
  termValidCount   Int? // 落地時「當屆有效票總數」快照，供 2/5 罷免門檻（不即時查 sourceElection）
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  editLogs         OfficeEditLog[]
  fillingElections Election[]      @relation("ElectionFillsOffice")
  recalls          Election[]      @relation("RecallTargetOffice")

  @@index([isVacant])
}

// 選舉層級稽核留痕：金鑰、狀態機推進、名冊異動、公告發布、結果提交等關鍵動作各留一筆，
// 供選後爭議還原「誰、何時、做了什麼」，也讓選委能自證清白。diff 只放足以重建事實的最小
// 資料（狀態轉換 from/to、名冊筆數、結果關鍵數字…），不得塞整份 resultsJson 或整份名冊。
model ElectionAuditLog {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  actorEmail String
  action     String // advance_status | submit_results | import_roster | remove_voter | hide_election | restore_election | save_public_key | publish_announcement | redo_election
  summary    String // 人類可讀一行
  diff       Json // 最小可還原資料，形狀依 action 而定

  createdAt DateTime @default(now())

  @@index([electionId, createdAt])
}

// 職務編輯留痕：每次自動 upsert 或手動編輯都寫一筆，供「誰、何時、改了什麼」重播。
model OfficeEditLog {
  id          String   @id @default(cuid())
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  editorEmail String // 手動＝選委 email；自動＝固定 "system:election-publish"
  action      String // create | update | manual_create | manual_edit
  summary     String // 人類可讀一行
  diff        Json // {field:{from,to}}，只記有變動欄位，供時間軸重播
  createdAt   DateTime @default(now())

  @@index([officeId, createdAt])
}
